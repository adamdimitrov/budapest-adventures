{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.py",
            "use": "@vercel/python"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/cron",
            "dest": "/api/cron.py"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
