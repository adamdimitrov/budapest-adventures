{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/cron.py": {
      "maxDuration": 60,
      "excludeFiles": "{assets/**,data/**,bg/**,cs/**,da/**,de/**,el/**,es/**,fi/**,fr/**,he/**,hr/**,hu/**,it/**,ja/**,ko/**,nl/**,no/**,pl/**,pt/**,ro/**,ru/**,sk/**,sr/**,sv/**,th/**,tr/**,uk/**,vi/**,zh/**,*.html,*.js,*.css,*.json,*.xml,*.jpg}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|webp|avif|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(js|css|webp|avif|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/zh/布达佩斯最佳河流游轮:slug(.*)",
