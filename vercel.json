{
    "version": 2,
    "cleanUrls": true,
    "builds": [
        {
            "src": "api/**/*.py",
            "use": "@vercel/python"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/cron",
            "dest": "/api/cron.py"
        },
        {
            "src": "/legenda-city-cruises",
            "dest": "/legenda-city-cruises.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
